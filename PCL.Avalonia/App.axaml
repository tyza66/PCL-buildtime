<Application
    x:Class="PCL.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:PCL.Avalonia.Converters;assembly=PCL2.Avalonia"
    RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PCL2.Avalonia/Themes/AppStyles.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <conv:IsEmptyCollectionConverter x:Key="IsEmptyCount" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PCL2.Avalonia/Themes/ThemeColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
