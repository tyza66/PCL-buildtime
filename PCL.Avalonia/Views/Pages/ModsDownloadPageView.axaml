<UserControl
    x:Class="PCL.Avalonia.Views.Pages.ModsDownloadPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:ctl="clr-namespace:PCL.Avalonia.Controls;assembly=PCL2.Avalonia"
    x:DataType="vm:ModsDownloadPageViewModel">
    <DockPanel Margin="32">
        <Grid
            DockPanel.Dock="Top"
            RowDefinitions="Auto,Auto"
            Margin="0,0,0,14">
            <StackPanel
                Grid.Row="0"
                Spacing="2">
                <TextBlock
                    Text="Mod下载"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock
                    Text="{Binding JavaHintText}"
                    IsVisible="{Binding JavaHintText, Converter={StaticResource StringNotEmpty}}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    ToolTip.Tip="{Binding JavaHintText}" />
            </StackPanel>
            <Grid
                Grid.Row="1"
                Margin="0,10,0,0">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
                    <TextBox
                        Text="{Binding SearchText}"
                        Watermark="搜索 Mod"
                        Width="180"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ComboBox
                        ItemsSource="{Binding GameVersions}"
                        SelectedItem="{Binding GameVersion}"
                        MinWidth="104"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Background="{DynamicResource ButtonBackgroundBrush}" />
                    <ComboBox
                        ItemsSource="{Binding Loaders}"
                        SelectedItem="{Binding Loader}"
                        MinWidth="104"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Background="{DynamicResource ButtonBackgroundBrush}" />
                    <ComboBox
                        ItemsSource="{Binding Sources}"
                        SelectedItem="{Binding Source}"
                        MinWidth="104"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Background="{DynamicResource ButtonBackgroundBrush}" />
                    <Button
                        Content="搜索"
                        MinWidth="72"
                        Command="{Binding SearchCommand}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White" />
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel
            DockPanel.Dock="Bottom"
            Spacing="6"
            Margin="0,14,0,0"
            IsVisible="{Binding IsProgressVisible}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Text="{Binding ProgressText}"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button
                    Grid.Column="1"
                    Content="取消"
                    Command="{Binding CancelCommand}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
            <ProgressBar
                Minimum="0"
                Maximum="100"
                Value="{Binding ProgressPercent}" />
        </StackPanel>
        <Border
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="8">
            <Panel>
            <ListBox
                ItemsSource="{Binding Projects}"
                Background="Transparent"
                BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadProjectItemViewModel">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                            Margin="14,10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock
                                        Text="已安装"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        IsVisible="{Binding IsInstalled}"
                                        Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                                <TextBlock
                                    Text="{Binding Description}"
                                    FontSize="12"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        Text="{Binding AuthorText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{Binding DownloadsText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{Binding CategoriesText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="安装"
                                VerticalAlignment="Center"
                                Command="{Binding InstallCommand}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ctl:EmptyState
                IsVisible="{Binding Projects.Count, Converter={StaticResource IsEmptyCount}}"
                Title="没有找到 Mod"
                Description="调整搜索词、游戏版本或加载器后重试" />
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
