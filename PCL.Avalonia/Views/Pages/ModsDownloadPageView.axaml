<UserControl
    x:Class="PCL.Avalonia.Views.Pages.ModsDownloadPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    x:DataType="vm:ModsDownloadPageViewModel">
    <DockPanel Margin="32">
        <Grid
            DockPanel.Dock="Top"
            RowDefinitions="Auto,Auto"
            ColumnDefinitions="*,116,150,132,96"
            RowSpacing="8"
            ColumnSpacing="8"
            Margin="0,0,0,14">
            <StackPanel
                Grid.ColumnSpan="4"
                Grid.Row="0"
                Spacing="2">
                <TextBlock
                    Text="Mod下载"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <TextBox
                Grid.Row="1"
                Text="{Binding SearchText}"
                Watermark="搜索 Mod"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextPrimaryBrush}" />
            <ComboBox
                Grid.Column="1"
                Grid.Row="1"
                ItemsSource="{Binding GameVersions}"
                SelectedItem="{Binding GameVersion}"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Background="{DynamicResource ButtonBackgroundBrush}" />
            <ComboBox
                Grid.Column="2"
                Grid.Row="1"
                ItemsSource="{Binding Loaders}"
                SelectedItem="{Binding Loader}"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Background="{DynamicResource ButtonBackgroundBrush}" />
            <ComboBox
                Grid.Column="3"
                Grid.Row="1"
                ItemsSource="{Binding Sources}"
                SelectedItem="{Binding Source}"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Background="{DynamicResource ButtonBackgroundBrush}" />
            <Button
                Grid.Column="4"
                Grid.Row="1"
                Content="搜索"
                VerticalAlignment="Top"
                Command="{Binding SearchCommand}"
                Background="{DynamicResource AccentBrush}"
                Foreground="White" />
        </Grid>
        <StackPanel
            DockPanel.Dock="Bottom"
            Spacing="6"
            Margin="0,14,0,0"
            IsVisible="{Binding IsProgressVisible}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Text="{Binding ProgressText}"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button
                    Grid.Column="1"
                    Content="取消"
                    Command="{Binding CancelCommand}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
            <ProgressBar
                Minimum="0"
                Maximum="100"
                Value="{Binding ProgressPercent}" />
        </StackPanel>
        <Border
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="8">
            <ListBox
                ItemsSource="{Binding Projects}"
                Background="Transparent"
                BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadProjectItemViewModel">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="8"
                            Margin="14,10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock
                                        Text="已安装"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        IsVisible="{Binding IsInstalled}"
                                        Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                                <TextBlock
                                    Text="{Binding Description}"
                                    FontSize="12"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        Text="{Binding AuthorText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{Binding DownloadsText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{Binding CategoriesText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="安装"
                                VerticalAlignment="Center"
                                Command="{Binding InstallCommand}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
