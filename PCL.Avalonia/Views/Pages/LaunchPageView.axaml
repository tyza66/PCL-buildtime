<UserControl
    x:Class="PCL.Avalonia.Views.Pages.LaunchPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:ctl="clr-namespace:PCL.Avalonia.Controls;assembly=PCL2.Avalonia"
    x:DataType="vm:LaunchPageViewModel">
    <DockPanel Margin="32">
        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,14">
            <StackPanel Spacing="2">
                <TextBlock
                    Text="启动"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock
                    Text="{Binding VersionStatus}"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <Button
                    Content="启动游戏"
                    Command="{Binding LaunchCommand}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" />
                <Button
                    Content="终止"
                    Command="{Binding CancelCommand}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="300,*" ColumnSpacing="12">
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <TextBlock
                    Classes="sectionheader"
                    Text="已安装的版本"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button
                        Grid.Column="1"
                        Content="刷新"
                        MinWidth="72"
                        Command="{Binding RefreshInstalledCommand}"
                        IsEnabled="{Binding !IsRefreshing}"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
                <Panel Grid.Row="1">
                    <Border
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="8">
                        <ListBox
                            ItemsSource="{Binding InstalledVersions}"
                            SelectedItem="{Binding SelectedInstalledVersion}"
                            Background="Transparent"
                            BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LaunchVersionItemViewModel">
                                    <Grid Margin="12,9" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{Binding Id}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock
                                                Text="{Binding Subtitle}"
                                                FontSize="11"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="★"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsFavorite}"
                                            Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <ctl:EmptyState
                        IsVisible="{Binding InstalledVersions.Count, Converter={StaticResource IsEmptyCount}}"
                        Title="还没有已安装的版本"
                        Description="到下载页安装一个版本，或到设置页指定已有的游戏目录" />
                </Panel>
                <!-- One compact row instead of a wrapping path card stacked under a full-width button. -->
                <Border
                    Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12,0"
                    MinHeight="46">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock
                            Text="{Binding GameFolderText}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding GameFolderText}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button
                            Grid.Column="1"
                            Content="打开目录"
                            MinWidth="72"
                            VerticalAlignment="Center"
                            Command="{Binding OpenGameFolderCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
                <Grid
                    Grid.Row="0"
                    MinHeight="34"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                    <TextBlock
                        Classes="sectionheader"
                        Text="运行日志"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding StatusMessage}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <Border
                    Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <TextBox
                        Text="{Binding LogText}"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Menlo,Consolas,DejaVu Sans Mono,monospace"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
