<UserControl
    x:Class="PCL.Avalonia.Views.Pages.LaunchPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:ctl="clr-namespace:PCL.Avalonia.Controls;assembly=PCL2.Avalonia"
    x:DataType="vm:LaunchPageViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.javastatus">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.javaalert">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
    </UserControl.Styles>
    <DockPanel Margin="32">
        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,14">
            <StackPanel Spacing="2">
                <TextBlock
                    Text="启动"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock
                    Text="{Binding VersionStatus}"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <Button
                    Content="启动游戏"
                    Command="{Binding LaunchCommand}"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White" />
                <Button
                    Content="终止"
                    Command="{Binding CancelCommand}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="300,*" ColumnSpacing="12">
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">
                <TextBlock
                    Classes="sectionheader"
                    Text="已安装的版本"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button
                        Grid.Column="1"
                        Content="刷新"
                        MinWidth="72"
                        Command="{Binding RefreshInstalledCommand}"
                        IsEnabled="{Binding !IsRefreshing}"
                        Background="{DynamicResource ButtonBackgroundBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
                <Panel Grid.Row="1">
                    <Border
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="8">
                        <ListBox
                            ItemsSource="{Binding InstalledVersions}"
                            SelectedItem="{Binding SelectedInstalledVersion}"
                            Background="Transparent"
                            BorderThickness="0">
                            <!-- 内容铺满整行：默认的列表项会把内容竖直居中，行内留出的空带吃不到右键。 -->
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LaunchVersionItemViewModel">
                                    <!-- Background=Transparent 且内边距改由子容器承担：整行都命中得到，
                                         右键落在卡片留白里也能弹出菜单。 -->
                                    <Grid
                                        Background="Transparent"
                                        Margin="0"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="选择该版本" Command="{Binding SelectItemCommand}" />
                                                <MenuItem Header="{Binding FavoriteText}" Command="{Binding FavoriteCommand}" />
                                                <MenuItem Header="打开版本文件夹" Command="{Binding OpenFolderCommand}" />
                                                <Separator />
                                                <MenuItem Header="删除版本" Command="{Binding DeleteCommand}" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <StackPanel Margin="12,9" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                Text="{Binding Id}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock
                                                Text="{Binding Subtitle}"
                                                FontSize="11"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,9,12,9"
                                            Text="★"
                                            FontSize="13"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsFavorite}"
                                            Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <ctl:EmptyState
                        IsVisible="{Binding InstalledVersions.Count, Converter={StaticResource IsEmptyCount}}"
                        Title="还没有已安装的版本"
                        Description="到下载页安装一个版本，或到设置页指定已有的游戏目录" />
                </Panel>
                <!-- One compact row instead of a wrapping path card stacked under a full-width button. -->
                <!-- Java 状态常驻一行：没装或版本对不上时在这里就说清楚，不用等点了启动才报错。 -->
                <Border
                    Grid.Row="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12,0"
                    MinHeight="46">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock
                            Text="Java"
                            FontSize="12"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Classes="javastatus"
                            Classes.javaalert="{Binding JavaStatusIsError}"
                            Text="{Binding JavaStatusText}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding JavaStatusText}" />
                    </Grid>
                </Border>
                <Border
                    Grid.Row="3"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12,0"
                    MinHeight="46">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock
                            Text="{Binding GameFolderText}"
                            FontSize="12"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding GameFolderText}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button
                            Grid.Column="1"
                            Content="打开目录"
                            MinWidth="72"
                            VerticalAlignment="Center"
                            Command="{Binding OpenGameFolderCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
                <Grid
                    Grid.Row="0"
                    MinHeight="34"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8">
                    <TextBlock
                        Classes="sectionheader"
                        Text="运行日志"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding StatusMessage}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <Border
                    Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <TextBox
                        Text="{Binding LogText}"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Menlo,Consolas,DejaVu Sans Mono,monospace"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
