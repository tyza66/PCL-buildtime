<UserControl
    x:Class="PCL.Avalonia.Views.Pages.SettingsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:pages="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:services="clr-namespace:PCL.Avalonia.Services;assembly=PCL2.Avalonia"
    x:DataType="vm:SettingsPageViewModel">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="12">
            <TextBlock
                Text="设置"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}" />
            <TabControl
                x:Name="SettingsTabs"
                Margin="0,14,0,0"
                SelectionChanged="SettingsTabs_OnSelectionChanged"
                Background="{DynamicResource CardBackgroundBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}">
                <TabItem Header="启动">
                    <StackPanel Margin="0,14,0,0" Spacing="12">
                        <TextBlock
                            Text="游戏目录"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding MinecraftFolder}"
                            Watermark="例如：~/.minecraft"
                            Foreground="{DynamicResource TextPrimaryBrush}" />

                        <TextBlock
                            Text="版本隔离"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding VersionIsolationDefaults}"
                            SelectedItem="{Binding VersionIsolationMode}"
                            ToolTip.Tip="{Binding VersionIsolationMode.Description}"
                            Foreground="{DynamicResource TextPrimaryBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:VersionIsolationOption">
                                    <TextBlock
                                        Text="{Binding Label}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Text="决定新安装版本的默认隔离策略；已有版本可在版本页的“设置”页签单独调整。"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock
                            Text="Java 路径"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding JavaPath}"
                            Watermark="java 或 java.exe 的完整路径"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="已检测到的 Java"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Panel Grid.Column="0" MinHeight="140">
                                <ListBox
                                    ItemsSource="{Binding JavaEntries}"
                                SelectedItem="{Binding SelectedJava}"
                                MaxHeight="140"
                                Background="{DynamicResource CardBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="services:JavaInfo">
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{Binding Version}"
                                                FontSize="13"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding Path}"
                                                FontSize="11"
                                                Opacity="0.7" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock
                                                    Text="{Binding Architecture}"
                                                    FontSize="10"
                                                    Opacity="0.5"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Text="与本机架构不一致"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Architecture, Converter={StaticResource JavaArchitectureMismatch}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                                <StackPanel
                                    IsVisible="{Binding JavaEntries.Count, Converter={StaticResource IsEmptyCount}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="18"
                                    Spacing="2">
                                    <TextBlock
                                        Text="没有检测到 Java"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock
                                        Text="点右侧「刷新」重新扫描；还是检不出来，就用下面的按钮安装"
                                        FontSize="11"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        MaxWidth="320"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Panel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="6">
                                <Button
                                    Content="刷新"
                                    Command="{Binding RefreshJavaListCommand}"
                                    IsEnabled="{Binding !IsScanningJava}"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button
                                    Content="选择"
                                    Command="{Binding SelectJavaCommand}"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel
                            x:Name="JavaInstallPanel"
                            IsVisible="{Binding ShowJavaInstallButton}"
                            Margin="0,8,0,0"
                            Spacing="6">
                            <Button
                                Content="{Binding SuggestedJavaMajor, StringFormat='下载并安装 Java {0}'}"
                                Command="{Binding InstallJavaCommand}"
                                CommandParameter="{Binding SuggestedJavaMajor}"
                                IsEnabled="{Binding !IsInstallingJava}"
                                HorizontalAlignment="Left"
                                Padding="16,6"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ProgressBar
                                IsVisible="{Binding IsInstallingJava}"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding JavaInstallFraction}" />
                            <TextBlock
                                Text="{Binding JavaInstallProgressText}"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            Text="用户名"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding UserName}"
                            Watermark="玩家名"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="最大内存（MB）"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding MaxMemoryMb}"
                            Watermark="4096"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox
                            Content="启动前优化内存"
                            IsChecked="{Binding OptimizeMemoryBeforeLaunch}"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="JVM 启动参数"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding JvmArguments}"
                            AcceptsReturn="True"
                            Height="84"
                            Watermark="例如：-Dminecraft.api=1"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="游戏启动参数"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding GameArguments}"
                            AcceptsReturn="True"
                            Height="84"
                            Watermark="例如：--demo"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="下载">
                    <StackPanel Margin="0,14,0,0" Spacing="12">
                        <TextBlock
                            Text="文件下载源"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ComboBox
                            ItemsSource="{Binding DownloadSources}"
                            SelectedItem="{Binding DownloadSource}"
                            Background="{DynamicResource CardBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="pages:DownloadSourceOption">
                                    <TextBlock
                                        Text="{Binding Label}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Text="最大线程数"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding DownloadThreads}"
                            Watermark="64（1 - 255）"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="速度限制（KB/s）"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,14,0,0"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding DownloadSpeedLimitKbps}"
                            Watermark="0 表示不限速"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="个性化">
                    <StackPanel Margin="0,14,0,0" Spacing="12">
                        <CheckBox
                            Content="使用深色主题"
                            IsChecked="{Binding UseDarkTheme}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="联机（暂不可用）">
                    <StackPanel Margin="0,14,0,0" Spacing="12">
                        <TextBlock
                            Text="联机暂不可用：依赖的公共节点服务已下线，以下配置暂时不会生效，服务恢复后无需重新设置。"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                        <!-- 侧边栏入口已置灰，这里同步停用控件：整组禁用并压暗，说明文案保持正常可读。 -->
                        <StackPanel IsEnabled="False" Opacity="0.45" Spacing="12">
                            <TextBlock
                                Text="模式"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox
                                ItemsSource="{Binding LinkLatencyModes}"
                                SelectedItem="{Binding LinkLatencyMode}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="pages:LinkLatencyModeOption">
                                        <TextBlock
                                            Text="{Binding Label}"
                                            Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                Text="自定义节点"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Margin="0,14,0,0"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBox
                                Text="{Binding LinkCustomPeer}"
                                Watermark="tcp://public.easytier.cn:11010"
                                ToolTip.Tip="使用逗号分隔多个节点，例如：tcp://public.easytier.cn:11010,tcp://public2.easytier.cn:54321"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                Margin="0,14,0,0">
                <Button
                    Content="保存设置"
                    Command="{Binding SaveCommand}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
