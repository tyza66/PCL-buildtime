<UserControl
    x:Class="PCL.Avalonia.Views.Pages.ForgelikeLoaderPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:ctl="clr-namespace:PCL.Avalonia.Controls;assembly=PCL2.Avalonia"
    x:DataType="vm:ForgelikeLoaderPageViewModel">
    <DockPanel Margin="32">
        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*,220,Auto,Auto"
            ColumnSpacing="8"
            Margin="0,0,0,14">
            <StackPanel Spacing="2">
                <TextBlock
                    Text="Forge / NeoForge"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock
                    Text="{Binding JavaHintText}"
                    IsVisible="{Binding JavaHintText, Converter={StaticResource StringNotEmpty}}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    ToolTip.Tip="{Binding JavaHintText}" />
            </StackPanel>
            <TextBox
                Grid.Column="1"
                Text="{Binding GameVersionText}"
                Watermark="游戏版本，如 1.20.1"
                IsEnabled="{Binding IsForgeMode}"
                Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button
                Grid.Column="2"
                Content="安装所选"
                Command="{Binding InstallCommand}"
                Background="{DynamicResource AccentBrush}"
                Foreground="White" />
            <Button
                Grid.Column="3"
                Content="刷新"
                Command="{Binding RefreshCommand}"
                Background="{DynamicResource ButtonBackgroundBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <StackPanel
            DockPanel.Dock="Top"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,0,0,14">
            <StackPanel.Styles>
                <Style Selector="Button.mode">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Style>
                <Style Selector="Button.mode.active">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                </Style>
            </StackPanel.Styles>
            <Button
                Content="Forge"
                Command="{Binding SelectForgeCommand}"
                Classes="mode"
                Classes.active="{Binding IsForgeMode}" />
            <Button
                Content="NeoForge"
                Command="{Binding SelectNeoForgeCommand}"
                Classes="mode"
                Classes.active="{Binding IsNeoForgeMode}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding ModeTitle}"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
        <StackPanel
            DockPanel.Dock="Bottom"
            Spacing="6"
            Margin="0,14,0,0"
            IsVisible="{Binding IsProgressVisible}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    Text="{Binding ProgressText}"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button
                    Grid.Column="1"
                    Content="取消"
                    Command="{Binding CancelCommand}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
            <ProgressBar
                Minimum="0"
                Maximum="100"
                Value="{Binding ProgressPercent}" />
        </StackPanel>
        <Panel>
            <Border
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8">
                <ListBox
                    ItemsSource="{Binding Versions}"
                    SelectedItem="{Binding SelectedLoader}"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ForgelikeLoaderVersionItemViewModel">
                            <StackPanel Margin="14,10" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        Text="{Binding VersionText}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock
                                        Text="{Binding MinecraftVersionText}"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{Binding StabilityText}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock
                                        Text="{Binding CategoryText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <ctl:EmptyState
                IsVisible="{Binding Versions.Count, Converter={StaticResource IsEmptyCount}}"
                Title="还没有加载器版本"
                Description="填写游戏版本，选择 Forge 或 NeoForge 后点击刷新" />
        </Panel>
    </DockPanel>
</UserControl>
