<UserControl
    x:Class="PCL.Avalonia.Views.Pages.VersionPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:ctl="clr-namespace:PCL.Avalonia.Controls;assembly=PCL2.Avalonia"
    x:DataType="vm:VersionPageViewModel">
    <UserControl.Styles>
        <!-- The detail column is too narrow for TabControl's header strip, where labels wrapped and
             overlapped; the panel draws its own segmented control instead. -->
        <Style Selector="ToggleButton.tabsegment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="6">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.tabsegment:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.tabsegment:checked">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- One rhythm for every form on this page: section label, then control, then action. -->
        <Style Selector="TextBlock.sectionlabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.formaction">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cardaction">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Styles>
    <DockPanel Margin="28">
        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            Margin="0,0,0,12">
            <StackPanel Spacing="2">
                <TextBlock
                    Text="版本"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <CheckBox
                Grid.Column="1"
                Content="显示隐藏版本"
                VerticalAlignment="Top"
                IsChecked="{Binding ShowHidden}"
                Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button
                Grid.Column="2"
                Content="刷新"
                MinWidth="72"
                VerticalAlignment="Top"
                Command="{Binding RefreshCommand}"
                Background="{DynamicResource ButtonBackgroundBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <Grid
            ColumnDefinitions="190,280,*"
            ColumnSpacing="12">
            <Border
                Grid.Column="0"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="12"
                        Spacing="6">
                        <TextBlock
                            Text="游戏目录"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding NewFolderName}"
                            Watermark="目录名称（可选）"
                            FontSize="12"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding NewFolderPath}"
                            Watermark="目录路径"
                            FontSize="12"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button
                            Classes="formaction"
                            Content="添加目录"
                            Command="{Binding AddFolderCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel
                        DockPanel.Dock="Bottom"
                        Margin="12,0,12,12"
                        Spacing="6">
                        <Button
                            Classes="formaction"
                            Content="打开目录"
                            Command="{Binding OpenCurrentFolderCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button
                            Classes="formaction"
                            Content="移除目录"
                            Command="{Binding RemoveFolderCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <ListBox
                        ItemsSource="{Binding Folders}"
                        SelectedItem="{Binding SelectedFolder}"
                        Background="Transparent"
                        BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderItemViewModel">
                                <Grid
                                    RowDefinitions="Auto,Auto"
                                    Margin="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border
                                            IsVisible="{Binding IsDefault}"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentBrush}"
                                            Padding="5,1">
                                            <TextBlock
                                                Text="默认"
                                                FontSize="10"
                                                Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{Binding Path}"
                                        FontSize="11"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border
                Grid.Column="1"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8">
                <ScrollViewer>
                    <ItemsControl
                        ItemsSource="{Binding Groups}"
                        Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InstanceGroupViewModel">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock
                                        Text="{Binding HeaderText}"
                                        IsVisible="{Binding IsVisible}"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Margin="2,0,0,4"
                                        Foreground="{DynamicResource AccentBrush}" />
                                    <ItemsControl
                                        ItemsSource="{Binding Items}"
                                        IsVisible="{Binding IsVisible}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VersionItemViewModel">
                                                <Border
                                                    Margin="0,0,0,6"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource PageBackgroundBrush}"
                                                Padding="10">
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                Text="{Binding Id}"
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock
                                                                FontSize="10"
                                                                TextTrimming="CharacterEllipsis"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                Text="{Binding TypeAndTimeText}" />
                                                        </StackPanel>
                                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                            <Button
                                                                Classes="cardaction"
                                                                Grid.Column="0"
                                                                Content="{Binding FavoriteButtonText}"
                                                                FontSize="11"
                                                                Command="{Binding FavoriteCommand}"
                                                                Background="{DynamicResource ButtonBackgroundBrush}"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <Button
                                                                Classes="cardaction"
                                                                Grid.Column="1"
                                                                Content="打开"
                                                                FontSize="11"
                                                                Command="{Binding OpenFolderCommand}"
                                                                Background="{DynamicResource ButtonBackgroundBrush}"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <Button
                                                                Classes="cardaction"
                                                                Grid.Column="2"
                                                                Content="选择"
                                                                FontSize="11"
                                                                Command="{Binding SelectCommand}"
                                                                Background="{DynamicResource AccentBrush}"
                                                                Foreground="{DynamicResource TextOnAccentBrush}" />
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                                            <Button
                                                                Classes="cardaction"
                                                                Grid.Column="0"
                                                                Content="{Binding HiddenButtonText}"
                                                                FontSize="11"
                                                                Command="{Binding HiddenCommand}"
                                                                Background="{DynamicResource ButtonBackgroundBrush}"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <Button
                                                                Classes="cardaction"
                                                                Grid.Column="1"
                                                                Content="删除"
                                                                FontSize="11"
                                                                Command="{Binding DeleteCommand}"
                                                                Background="{DynamicResource DangerBrush}"
                                                                Foreground="{DynamicResource TextOnAccentBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <ctl:EmptyState
                Grid.Column="1"
                IsVisible="{Binding Versions.Count, Converter={StaticResource IsEmptyCount}}"
                Title="还没有安装任何版本"
                Description="去下载页安装一个版本，或把已有的游戏目录添加到左侧" />
            <Border
                Grid.Column="2"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8">
                <DockPanel>
                    <Grid
                        DockPanel.Dock="Top"
                        Margin="8,8,8,0"
                        ColumnDefinitions="Auto,Auto,Auto,Auto"
                        HorizontalAlignment="Left"
                        ColumnSpacing="4">
                        <ToggleButton
                            Grid.Column="0"
                            Classes="tabsegment"
                            Content="总体"
                            IsChecked="{Binding IsOverviewTab, Mode=OneWay}"
                            Command="{Binding SelectDetailTabCommand}"
                            CommandParameter="0" />
                        <ToggleButton
                            Grid.Column="1"
                            Classes="tabsegment"
                            Content="Mod"
                            IsChecked="{Binding IsModsTab, Mode=OneWay}"
                            Command="{Binding SelectDetailTabCommand}"
                            CommandParameter="1" />
                        <ToggleButton
                            Grid.Column="2"
                            Classes="tabsegment"
                            Content="设置"
                            IsChecked="{Binding IsSettingsTab, Mode=OneWay}"
                            Command="{Binding SelectDetailTabCommand}"
                            CommandParameter="2" />
                        <ToggleButton
                            Grid.Column="3"
                            Classes="tabsegment"
                            Content="导出"
                            IsChecked="{Binding IsExportTab, Mode=OneWay}"
                            Command="{Binding SelectDetailTabCommand}"
                            CommandParameter="3" />
                    </Grid>
                    <Panel Margin="0,10,0,0">
                        <ScrollViewer IsVisible="{Binding IsOverviewTab}">
                            <StackPanel Margin="12" Spacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="{Binding SelectedItem.Id, TargetNullValue=未选择版本}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Text="{Binding SelectedItem.Type, TargetNullValue=未知类型}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock
                                            Text="{Binding SelectedItem.ReleaseTimeText, TargetNullValue=未知时间}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    Classes="sectionlabel"
                                    Text="描述" />
                                <TextBox
                                    Text="{Binding DescriptionInput}"
                                    AcceptsReturn="True"
                                    Height="72"
                                    Watermark="自定义描述"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button
                                    Classes="formaction"
                                    Content="保存描述"
                                    Command="{Binding SaveDescriptionCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource TextOnAccentBrush}" />
                                <TextBlock
                                    Classes="sectionlabel"
                                    Text="分类" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding DisplayTypeOptions}"
                                    SelectedItem="{Binding DisplayType}"
                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DisplayTypeOption">
                                            <TextBlock
                                                Text="{Binding Label}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="8"
                                    RowSpacing="8">
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Content="打开版本目录"
                                        Command="{Binding OpenVersionFolderCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Content="打开存档"
                                        Command="{Binding OpenSavesFolderCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Content="打开 Mod 目录"
                                        Command="{Binding OpenModsFolderCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Content="打开截图"
                                        Command="{Binding OpenScreenshotsFolderCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                                <TextBlock
                                    Classes="sectionlabel"
                                    Text="重命名" />
                                <TextBox
                                    Text="{Binding NewName}"
                                    Watermark="新版本名称"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button
                                    Classes="formaction"
                                    Content="重命名"
                                    Command="{Binding RenameCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource TextOnAccentBrush}" />
                                <TextBlock
                                    Classes="sectionlabel"
                                    Text="更多操作" />
                                <Button
                                    Classes="formaction"
                                    Content="导出启动脚本"
                                    Command="{Binding ExportScriptCommand}"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button
                                    Classes="formaction"
                                    Content="删除版本"
                                    Command="{Binding SelectedItem.DeleteCommand}"
                                    Background="{DynamicResource DangerBrush}"
                                    Foreground="{DynamicResource TextOnAccentBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                        <DockPanel IsVisible="{Binding IsModsTab}">
                            <TextBlock
                                DockPanel.Dock="Top"
                                Text="{Binding ModsStatus}"
                                FontSize="12"
                                Margin="12,0,12,8"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ListBox
                                ItemsSource="{Binding Mods}"
                                Background="Transparent"
                                BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModItemViewModel">
                                        <Grid
                                            ColumnDefinitions="*,Auto,Auto"
                                            ColumnSpacing="6"
                                            Margin="12,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Text="{Binding DisplayName}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        Text="{Binding EnabledText}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock
                                                        Text="{Binding SizeText}"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Content="{Binding ToggleButtonText}"
                                                FontSize="11"
                                                Command="{Binding ToggleCommand}"
                                                Background="{DynamicResource ButtonBackgroundBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Button
                                                Grid.Column="2"
                                                Content="删除"
                                                FontSize="11"
                                                Command="{Binding DeleteCommand}"
                                                Background="{DynamicResource DangerBrush}"
                                                Foreground="{DynamicResource TextOnAccentBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <ScrollViewer IsVisible="{Binding IsSettingsTab}">
                            <StackPanel Margin="12" Spacing="8">
                                <TextBlock
                                    Classes="sectionlabel"
                                    Text="内存" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding MemoryModeOptions}"
                                    SelectedItem="{Binding MemoryMode}"
                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MemoryModeOption">
                                            <TextBlock
                                                Text="{Binding Label}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox
                                    Text="{Binding MaxMemoryInput}"
                                    Watermark="手动内存（MB）"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock
                                    Classes="sectionlabel"
                                    Text="Java 路径" />
                                <TextBox
                                    Text="{Binding JavaPathInput}"
                                    Watermark="留空则跟随全局"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock
                                    Classes="sectionlabel"
                                    Text="JVM 启动参数" />
                                <TextBox
                                    Text="{Binding JvmArgumentsInput}"
                                    AcceptsReturn="True"
                                    Height="72"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock
                                    Classes="sectionlabel"
                                    Text="游戏启动参数" />
                                <TextBox
                                    Text="{Binding GameArgumentsInput}"
                                    AcceptsReturn="True"
                                    Height="72"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="8"
                                    Margin="0,6,0,0">
                                    <Button
                                        Grid.Column="0"
                                        Content="保存设置"
                                        Command="{Binding SaveInstanceSettingsCommand}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource TextOnAccentBrush}" />
                                    <Button
                                        Grid.Column="1"
                                        Content="重置独立设置"
                                        Command="{Binding ResetInstanceSettingsCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer IsVisible="{Binding IsExportTab}">
                            <StackPanel Margin="12" Spacing="8">
                                <TextBlock
                                    Classes="sectionlabel"
                                    Text="整合包名称" />
                                <TextBox
                                    Text="{Binding ExportName}"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button
                                    Classes="formaction"
                                    Content="导出整合包"
                                    Command="{Binding ExportPackCommand}"
                                    IsEnabled="{Binding !IsExporting}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource TextOnAccentBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Panel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
