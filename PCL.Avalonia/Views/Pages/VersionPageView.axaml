<UserControl
    x:Class="PCL.Avalonia.Views.Pages.VersionPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:ctl="clr-namespace:PCL.Avalonia.Controls;assembly=PCL2.Avalonia"
    x:DataType="vm:VersionPageViewModel">
    <DockPanel Margin="28">
        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            Margin="0,0,0,12">
            <StackPanel Spacing="2">
                <TextBlock
                    Text="版本"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <CheckBox
                Grid.Column="1"
                Content="显示隐藏版本"
                VerticalAlignment="Top"
                IsChecked="{Binding ShowHidden}"
                Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button
                Grid.Column="2"
                Content="刷新"
                MinWidth="72"
                VerticalAlignment="Top"
                Command="{Binding RefreshCommand}"
                Background="{DynamicResource ButtonBackgroundBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <Grid
            ColumnDefinitions="210,330,*"
            ColumnSpacing="12">
            <Border
                Grid.Column="0"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8">
                <DockPanel>
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="12"
                        Spacing="6">
                        <TextBlock
                            Text="游戏目录"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding NewFolderName}"
                            Watermark="目录名称（可选）"
                            FontSize="12"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox
                            Text="{Binding NewFolderPath}"
                            Watermark="目录路径"
                            FontSize="12"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button
                            Content="添加目录"
                            HorizontalAlignment="Stretch"
                            Command="{Binding AddFolderCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel
                        DockPanel.Dock="Bottom"
                        Margin="12,0,12,12"
                        Spacing="6">
                        <Button
                            Content="打开目录"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenCurrentFolderCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button
                            Content="移除目录"
                            HorizontalAlignment="Stretch"
                            Command="{Binding RemoveFolderCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <ListBox
                        ItemsSource="{Binding Folders}"
                        SelectedItem="{Binding SelectedFolder}"
                        Background="Transparent"
                        BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderItemViewModel">
                                <Grid
                                    RowDefinitions="Auto,Auto"
                                    Margin="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border
                                            IsVisible="{Binding IsDefault}"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentBrush}"
                                            Padding="5,1">
                                            <TextBlock
                                                Text="默认"
                                                FontSize="10"
                                                Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{Binding Path}"
                                        FontSize="11"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Panel>
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8">
                    <ScrollViewer>
                        <ItemsControl
                            ItemsSource="{Binding Groups}"
                            Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:InstanceGroupViewModel">
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock
                                            Text="{Binding HeaderText}"
                                            IsVisible="{Binding IsVisible}"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Margin="2,0,0,4"
                                            Foreground="{DynamicResource AccentBrush}" />
                                        <ItemsControl
                                            ItemsSource="{Binding Items}"
                                            IsVisible="{Binding IsVisible}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:VersionItemViewModel">
                                                    <Border
                                                        Margin="0,0,0,6"
                                                        CornerRadius="6"
                                                        Background="{DynamicResource PageBackgroundBrush}"
                                                        Padding="10">
                                                        <StackPanel Spacing="6">
                                                            <Grid
                                                                ColumnDefinitions="*,Auto,Auto,Auto"
                                                                ColumnSpacing="6">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock
                                                                        Text="{Binding Id}"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock
                                                                            Text="{Binding Type}"
                                                                            FontSize="10"
                                                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                        <TextBlock
                                                                            Text="{Binding ReleaseTimeText}"
                                                                            FontSize="10"
                                                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Content="{Binding FavoriteButtonText}"
                                                                    MinWidth="52"
                                                                    FontSize="11"
                                                                    Command="{Binding FavoriteCommand}"
                                                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <Button
                                                                    Grid.Column="2"
                                                                    Content="打开"
                                                                    MinWidth="48"
                                                                    FontSize="11"
                                                                    Command="{Binding OpenFolderCommand}"
                                                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <Button
                                                                    Grid.Column="3"
                                                                    Content="选择"
                                                                    MinWidth="48"
                                                                    FontSize="11"
                                                                    Command="{Binding SelectCommand}"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    Foreground="White" />
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Button
                                                                    Content="{Binding HiddenButtonText}"
                                                                    MinWidth="64"
                                                                    FontSize="11"
                                                                    Command="{Binding HiddenCommand}"
                                                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <Button
                                                                    Content="删除"
                                                                    MinWidth="64"
                                                                    FontSize="11"
                                                                    Command="{Binding DeleteCommand}"
                                                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <ctl:EmptyState
                    IsVisible="{Binding Versions.Count, Converter={StaticResource IsEmptyCount}}"
                    Title="还没有安装任何版本"
                    Description="去下载页安装一个版本，或把已有的游戏目录添加到左侧" />
            </Panel>
            <Border
                Grid.Column="2"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8">
                <TabControl
                    SelectedIndex="{Binding SelectedDetailTab}"
                    Background="Transparent"
                    Foreground="{DynamicResource TextPrimaryBrush}">
                    <TabItem Header="总体">
                        <ScrollViewer>
                            <StackPanel Margin="14" Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="{Binding SelectedItem.Id, TargetNullValue=未选择版本}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock
                                            Text="{Binding SelectedItem.Type, TargetNullValue=未知类型}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock
                                            Text="{Binding SelectedItem.ReleaseTimeText, TargetNullValue=未知时间}"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    Text="描述"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBox
                                    Text="{Binding DescriptionInput}"
                                    AcceptsReturn="True"
                                    Height="64"
                                    Watermark="自定义描述"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button
                                    Content="保存描述"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SaveDescriptionCommand}"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock
                                    Text="分类"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ComboBox
                                    ItemsSource="{Binding DisplayTypeOptions}"
                                    SelectedItem="{Binding DisplayType}"
                                    Background="{DynamicResource PageBackgroundBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DisplayTypeOption">
                                            <TextBlock
                                                Text="{Binding Label}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <WrapPanel>
                                    <Button
                                        Content="打开版本目录"
                                        Margin="0,0,6,6"
                                        Command="{Binding OpenVersionFolderCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button
                                        Content="打开存档"
                                        Margin="0,0,6,6"
                                        Command="{Binding OpenSavesFolderCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button
                                        Content="打开 Mod 目录"
                                        Margin="0,0,6,6"
                                        Command="{Binding OpenModsFolderCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button
                                        Content="打开截图"
                                        Margin="0,0,6,6"
                                        Command="{Binding OpenScreenshotsFolderCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                </WrapPanel>
                                <TextBlock
                                    Text="重命名"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBox
                                    Text="{Binding NewName}"
                                    Watermark="新版本名称"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button
                                    Content="重命名"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RenameCommand}"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button
                                    Content="导出启动脚本"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ExportScriptCommand}"
                                    Background="{DynamicResource ButtonBackgroundBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button
                                    Content="删除版本"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SelectedItem.DeleteCommand}"
                                    Background="{DynamicResource DangerBrush}"
                                    Foreground="White" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Mod">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Text="{Binding ModsStatus}"
                                FontSize="12"
                                Margin="14,12,14,8"
                                Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ListBox
                                ItemsSource="{Binding Mods}"
                                Background="Transparent"
                                BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModItemViewModel">
                                        <Grid
                                            ColumnDefinitions="*,Auto,Auto"
                                            ColumnSpacing="6"
                                            Margin="12,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Text="{Binding DisplayName}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        Text="{Binding EnabledText}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock
                                                        Text="{Binding SizeText}"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Content="{Binding ToggleButtonText}"
                                                FontSize="11"
                                                Command="{Binding ToggleCommand}"
                                                Background="{DynamicResource ButtonBackgroundBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Button
                                                Grid.Column="2"
                                                Content="删除"
                                                FontSize="11"
                                                Command="{Binding DeleteCommand}"
                                                Background="{DynamicResource ButtonBackgroundBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="设置">
                        <ScrollViewer>
                            <StackPanel Margin="14" Spacing="10">
                                <TextBlock
                                    Text="内存"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ComboBox
                                    ItemsSource="{Binding MemoryModeOptions}"
                                    SelectedItem="{Binding MemoryMode}"
                                    Background="{DynamicResource PageBackgroundBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MemoryModeOption">
                                            <TextBlock
                                                Text="{Binding Label}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox
                                    Text="{Binding MaxMemoryInput}"
                                    Watermark="手动内存（MB）"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock
                                    Text="Java 路径"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBox
                                    Text="{Binding JavaPathInput}"
                                    Watermark="留空则跟随全局"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock
                                    Text="JVM 启动参数"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBox
                                    Text="{Binding JvmArgumentsInput}"
                                    AcceptsReturn="True"
                                    Height="72"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock
                                    Text="游戏启动参数"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBox
                                    Text="{Binding GameArgumentsInput}"
                                    AcceptsReturn="True"
                                    Height="72"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Content="保存设置"
                                        Command="{Binding SaveInstanceSettingsCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button
                                        Content="重置独立设置"
                                        Command="{Binding ResetInstanceSettingsCommand}"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="导出">
                        <StackPanel Margin="14" Spacing="10">
                            <TextBlock
                                Text="整合包名称"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBox
                                Text="{Binding ExportName}"
                                FontSize="12"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button
                                Content="导出整合包"
                                HorizontalAlignment="Left"
                                Command="{Binding ExportPackCommand}"
                                IsEnabled="{Binding !IsExporting}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
