<UserControl
    x:Class="PCL.Avalonia.Views.Pages.OtherPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    x:DataType="vm:OtherPageViewModel">
    <StackPanel Margin="32" Spacing="6">
        <TextBlock
            Text="其他"
            FontSize="26"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock
            Text="占位页"
            FontSize="14"
            Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
</UserControl>
