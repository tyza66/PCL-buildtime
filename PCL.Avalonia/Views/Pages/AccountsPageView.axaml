<UserControl
    x:Class="PCL.Avalonia.Views.Pages.AccountsPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:ctl="clr-namespace:PCL.Avalonia.Controls;assembly=PCL2.Avalonia"
    x:DataType="vm:AccountsPageViewModel">
    <DockPanel Margin="32">
        <Grid
            DockPanel.Dock="Top"
            ColumnDefinitions="*,240,Auto,Auto"
            ColumnSpacing="8"
            Margin="0,0,0,14">
            <StackPanel Spacing="2">
                <TextBlock
                    Text="账号管理"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock
                    Text="{Binding StatusMessage}"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <TextBox
                Grid.Column="1"
                Text="{Binding NewAccountName}"
                Watermark="离线账号名"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button
                Grid.Column="2"
                Content="添加"
                VerticalAlignment="Top"
                Command="{Binding AddCommand}"
                Background="{DynamicResource ButtonBackgroundBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}" />
            <Button
                Grid.Column="3"
                Content="登录微软账号"
                VerticalAlignment="Top"
                Command="{Binding MicrosoftLoginCommand}"
                Background="{DynamicResource AccentBrush}"
                Foreground="White" />
        </Grid>
        <Border
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="8">
            <Panel>
            <ListBox
                ItemsSource="{Binding Accounts}"
                Background="Transparent"
                BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountItemViewModel">
                        <Grid
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="8"
                            Margin="14,10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Border
                                        IsVisible="{Binding IsDefault}"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="4"
                                        Padding="6,1">
                                        <TextBlock
                                            Text="{Binding DefaultBadgeText}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextOnAccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock
                                        Text="{Binding TypeText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock
                                        Text="{Binding CreatedAtText}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="{Binding SetDefaultButtonText}"
                                VerticalAlignment="Center"
                                Command="{Binding SetDefaultCommand}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button
                                Grid.Column="2"
                                Content="删除"
                                VerticalAlignment="Center"
                                Command="{Binding RemoveCommand}"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ctl:EmptyState
                IsVisible="{Binding Accounts.Count, Converter={StaticResource IsEmptyCount}}"
                Title="还没有账号"
                Description="添加微软或离线账号后即可启动游戏" />
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
