<Window
    x:Class="PCL.Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Avalonia.ViewModels;assembly=PCL2.Avalonia"
    xmlns:pages="clr-namespace:PCL.Avalonia.ViewModels.Pages;assembly=PCL2.Avalonia"
    xmlns:views="clr-namespace:PCL.Avalonia.Views.Pages;assembly=PCL2.Avalonia"
    x:DataType="vm:MainWindowViewModel"
    Title="PCL2-R"
    Width="1080"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    Background="{DynamicResource WindowBackgroundBrush}"
    WindowStartupLocation="CenterScreen">
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type pages:LaunchPageViewModel}">
            <views:LaunchPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:DownloadPageViewModel}">
            <views:DownloadPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:FabricLoaderPageViewModel}">
            <views:FabricLoaderPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:ForgelikeLoaderPageViewModel}">
            <views:ForgelikeLoaderPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:ModsDownloadPageViewModel}">
            <views:ModsDownloadPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:ResourceDownloadPageViewModel}">
            <views:ResourceDownloadPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:IntegrationPacksPageViewModel}">
            <views:IntegrationPacksPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:VersionPageViewModel}">
            <views:VersionPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:ModsPageViewModel}">
            <views:ModsPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:LinkPageViewModel}">
            <views:LinkPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:AccountsPageViewModel}">
            <views:AccountsPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
            <views:SettingsPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:OtherPageViewModel}">
            <views:OtherPageView />
        </DataTemplate>
    </Window.DataTemplates>
    <DockPanel>
        <Border
            DockPanel.Dock="Left"
            Width="220"
            Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="16,18,16,10" Spacing="2">
                    <TextBlock
                        Text="PCL2-R"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock
                        Text="Minecraft 启动器"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem}"
                    Background="Transparent"
                    BorderThickness="0">
                    <!-- 13 个导航项必须在默认 720pt 窗口高度下完整可见：容器高度固定，行高不随字体行距膨胀。
                         文字垂直居中，靠 TextBlock 自身的左内边距留出缩进。 -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Height" Value="33" />
                            <Setter Property="Margin" Value="8,2" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItemViewModel">
                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="14"
                                Padding="14,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextPrimaryBrush}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button
                    Grid.Row="2"
                    Margin="8,8"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    Command="{Binding ToggleThemeCommand}"
                    Content="{Binding ThemeButtonText}" />
            </Grid>
        </Border>
        <Border Background="{DynamicResource PageBackgroundBrush}">
            <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" />
        </Border>
    </DockPanel>
</Window>
