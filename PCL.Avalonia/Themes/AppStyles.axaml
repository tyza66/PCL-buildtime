<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Buttons: a disabled button must read as disabled, not as a second kind of button. -->
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- List rows: themed hover/selection instead of FluentTheme's default blue. -->
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="6,2" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    </Style>

    <!-- Section headers: one size, one weight, one baseline, so a page's columns line up. -->
    <Style Selector="TextBlock.sectionheader">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Form controls share one height so toolbars line up. Multiline text boxes are exempt. -->
    <Style Selector="TextBox">
        <!-- FluentTheme's English Cut/Copy/Paste flyout is replaced by ChineseTextBoxMenu. -->
        <Setter Property="ContextFlyout" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="TextBox[AcceptsReturn=False]">
        <Setter Property="Height" Value="34" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="14,5" />
    </Style>

    <!-- Slimmer scrollbars keep list cards from looking crowded. -->
    <Style Selector="ScrollBar[Orientation=Vertical]">
        <Setter Property="Width" Value="10" />
    </Style>
    <Style Selector="ScrollBar[Orientation=Horizontal]">
        <Setter Property="Height" Value="10" />
    </Style>
</Styles>
